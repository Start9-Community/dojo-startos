#!/bin/bash
# Sourced by every Dojo entrypoint and health script.
#
# The S9_* variables are set on the daemon's environment by startos/main.ts,
# which resolves Bitcoin, the indexer and Tor over the LXC bridge. Upstream's
# own .env is sourced first for Dojo's defaults; everything StartOS resolved is
# applied after it, because sourcing it later would clobber all of it.

set -o allexport

source /home/node/app/docker/my-dojo/.env

DOJO_DATA_DIR="$S9_DATA_DIR"

# Bitcoin. The bridge address is `<os bridge ip>:<host-side port>`, and the same
# bridge ip fronts every binding of a given container, so the ZeroMQ endpoints
# contribute only their ports — which is all Dojo takes for them.
COMMON_BTC_NETWORK="$S9_BITCOIN_NETWORK"
BITCOIND_IP="$S9_BITCOIN_RPC_HOST"
BITCOIND_RPC_PORT="$S9_BITCOIN_RPC_PORT"
BITCOIND_ZMQ_BLK_HASH="${S9_BITCOIN_ZMQ_BLOCK##*:}"
BITCOIND_ZMQ_RAWTXS="${S9_BITCOIN_ZMQ_TX##*:}"

if [ -f "$S9_BITCOIN_COOKIE" ]; then
	COOKIE=$(cat "$S9_BITCOIN_COOKIE")
	BITCOIND_RPC_USER="${COOKIE%%:*}"
	BITCOIND_RPC_PASSWORD="${COOKIE#*:}"
else
	echo "[w] Bitcoin RPC cookie not found at $S9_BITCOIN_COOKIE" >&2
fi

# Indexer
NODE_ACTIVE_INDEXER=local_indexer
INDEXER_IP="$S9_INDEXER_HOST"
INDEXER_RPC_PORT="$S9_INDEXER_PORT"
INDEXER_BATCH_SUPPORT=active
INDEXER_PROTOCOL=tcp

# MariaDB, which only ever listens on loopback inside this container
MYSQL_USER=samourai
MYSQL_PASSWORD=samourai
MYSQL_DATABASE=samourai-main
NET_DOJO_MYSQL_IPV4=127.0.0.1

# Keys, minted once by startos/init/seedSecrets.ts
NODE_API_KEY="$S9_API_KEY"
NODE_ADMIN_KEY="$S9_ADMIN_KEY"
NODE_JWT_SECRET="$S9_JWT_SECRET"
NODE_PAYMENT_CODE="$S9_PAYMENT_CODE"
NODE_FEE_TYPE=ECONOMICAL

# Tor. TOR_ADDRESS is this Dojo's own onion, empty until the user adds one to
# the Web UI interface; the backend daemon does not start without it.
TOR_ADDRESS="$S9_TOR_ADDRESS"
NET_DOJO_TOR_IPV4="$S9_TOR_SOCKS_HOST"
TOR_SOCKS_PORT="$S9_TOR_SOCKS_PORT"

# Soroban / PandoTx
SOROBAN_INSTALL=on
SOROBAN_PORT=4242
NET_DOJO_SOROBAN_IPV4=127.0.0.1
SOROBAN_ONION_FILE=/var/lib/tor/hsv3soroban/hostname
SOROBAN_ANNOUNCE="$S9_SOROBAN_ANNOUNCE"
NODE_PANDOTX_PROCESS="$S9_PANDOTX_PROCESS"
NODE_PANDOTX_PUSH="$S9_PANDOTX_PUSH"
NODE_PANDOTX_FALLBACK_MODE="$S9_PANDOTX_FALLBACK"
NODE_PANDOTX_NB_RETRIES="$S9_PANDOTX_RETRIES"

# Upstream's compose stack runs a block explorer container alongside Dojo. This
# package ships no explorer, and points the wallet at mempool.space's onion
# instead — a third party, documented as such in the README. EXPLORER_TYPE has
# to match the endpoint: it is what Dojo reports as `explorer.<type>` in the
# pairing payload, and what the wallet uses to build transaction URLs.
EXPLORER_INSTALL=on
EXPLORER_TYPE=mempool_space
EXPLORER_ONION=mempoolhqx4isw62xs7abwphsq7ldayuidyx2v2oethdhhj6mlo2r6ad.onion

set +o allexport

# functions.sh caches the API access token here; /run is empty on a fresh boot.
mkdir -p /run/secrets
